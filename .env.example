# Modelo das variáveis de ambiente do NJC. NÃO coloque senhas reais aqui.
#
# No seu computador: copie para .njc_local.env (que fica fora do Git),
# troque os valores e rode "bash iniciar_local.sh".
# Em produção (Railway): as variáveis ficam na aba Variables do serviço.

# --- Banco de dados --------------------------------------------------------
# Produção: o Railway preenche MYSQL_URL sozinho (mysql://usuario:senha@host:porta/banco).
# Se MYSQL_URL existir, as DB_* abaixo são ignoradas.
# export MYSQL_URL=

# Local: usuário criado só para o projeto (ver README).
export DB_HOST=127.0.0.1
export DB_PORT=3306
export DB_USER=njc
export DB_PASSWORD=troque-pela-sua-senha
export DB_NAME=bmt

# --- Segurança -------------------------------------------------------------
# Chave que protege os cookies de login. Em produção, obrigatório definir uma
# longa e aleatória (ex.: python3 -c "import secrets; print(secrets.token_hex(32))").
# export SECRET_KEY=

# false só no computador local (sem HTTPS). Em produção, deixe sem definir.
export SESSION_COOKIE_SECURE=false
